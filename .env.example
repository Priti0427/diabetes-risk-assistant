# Copy to .env and fill in. Never commit .env.
#
# Nebius AI Studio (default provider; OpenAI-compatible API)
LLM_API_KEY=your-nebius-api-key-here
LLM_BASE_URL=https://api.studio.nebius.com/v1/
LLM_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct

# To use OpenAI instead, set:
# LLM_BASE_URL=https://api.openai.com/v1/
# LLM_MODEL=gpt-4o-mini

# Leave LLM_API_KEY empty to run in offline rule-based mode (no LLM calls).

# Silence MLflow's agent-skill hint in training logs
MLFLOW_DISABLE_AGENT_HINT=1
